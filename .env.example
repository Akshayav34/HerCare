# HerCare Production Deployment Environment Variables
# Configure these in Vercel Project Settings -> Environment Variables

# Canonical Public Application URL
# Used for generating bearer QR codes and first-responder links (without hardcoded localhost)
VITE_APP_URL=https://your-hercare-deployment.vercel.app

# Supabase Production Backend Integration
# Used for authentication, RLS database storage, and the get_emergency_card_by_token RPC function
# IMPORTANT: Only enter your public ANON key (JWT starting with eyJ...). NEVER expose service_role secrets!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Enable safe educational/demo exploration mode when database is unconfigured
VITE_ENABLE_DEMO_MODE=true
